# QuberBill / Frappe Deployment Environment Variables

# The domain name or site header to route requests to
SITE_NAME=frontend

# Database and Administrator credentials
ADMIN_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin

# Port on the host machine to bind frontend
FRONTEND_PORT=8082

# Frappe Site Name Header (default allows any host header)
FRAPPE_SITE_NAME_HEADER=frontend
